# Base44 Configuration
# Get these from: https://app.base44.com (your Base44 dashboard)
VITE_BASE44_APP_ID=your_app_id_here
VITE_BASE44_SERVER_URL=https://app.base44.com
# Optional: Token for authenticated requests (if using auth)
VITE_BASE44_TOKEN=your_token_here

# Mapbox Configuration
# IMPORTANT: Do NOT commit your real Mapbox token to git.
# Put the real token only in a local .env file that is ignored by git.
VITE_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE
